{
  "name": "shahi-unified-operations",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "node backend/src/server.js",
    "dev:frontend": "npm --prefix frontend start",
    "build": "npm --prefix frontend run build",
    "test:backend": "node --test backend/test/*.test.js",
    "db:migrate": "node backend/src/db/migrate.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/router": "^18.2.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.0.0",
    "postcss": "^8.5.31",
    "rxjs": "^7.8.1",
    "tailwindcss": "^3.4.17",
    "tslib": "^2.6.2",
    "typescript": "~5.5.4",
    "zone.js": "^0.14.10"
  }
}
